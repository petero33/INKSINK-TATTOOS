generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Artist {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  email        String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Client {
  id           String        @id @default(uuid())
  name         String
  phone        String        @unique
  email        String?
  preferences  String?       @db.Text
  allergies    String?       @db.Text
  notes        String?       @db.Text
  totalSpent   Int           @default(0)
  joinDate     DateTime      @default(now())
  requests     TattooRequest[]
  appointments Appointment[]
  reviews      Review[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model TattooRequest {
  id             String        @id @default(uuid())
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id])
  tattooIdea     String        @db.Text
  placement      String
  size           String
  style          String
  colorType      String
  budget         String
  preferredDate  DateTime?
  painTolerance  Int?
  referenceImages Json?         // Store array of image URLs/paths
  notes          String?       @db.Text
  status         RequestStatus @default(PENDING) // PENDING, ACCEPTED, DECLINED, CONSULTATION
  appointments   Appointment[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Appointment {
  id             String        @id @default(uuid())
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id])
  requestId      String?
  request        TattooRequest? @relation(fields: [requestId], references: [id])
  tattooType     String
  date           DateTime
  time           String
  duration       String
  notes          String?       @db.Text
  totalCost      Int           @default(0)
  depositAmount  Int           @default(0)
  depositPaid    Boolean       @default(false)
  mpesaReceiptNo String?
  status         ApptStatus    @default(CONFIRMED) // CONFIRMED, COMPLETED, CANCELLED
  reviews        Review[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Review {
  id            String      @id @default(uuid())
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id])
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  rating        Int
  text          String      @db.Text
  date          DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CONSULTATION
}

enum ApptStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
}
